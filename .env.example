# ================= 运行环境 =================
# 分发出口（逗号组合）：file=测试期写 txt 到 outbox/<用户QQ>/；pushplus=微信强推送；qq=内部测试
DELIVER_MODE=file
CLASSIFIER=stub            # stub=假分类器；tree=JEV 分类树（P2）

# 目录（相对项目根；全部在项目内，不写系统目录）
DATA_DIR=./data
LOG_DIR=./data/logs
CONFIG_DIR=./config
OUTBOX_DIR=./data/outbox

# ================= OneBot（NapCat 反向 WS：NapCat 来连我们）=================
ONEBOT_REVERSE_HOST=127.0.0.1
ONEBOT_REVERSE_PORT=3001
ONEBOT_TOKEN=change-me

# ================= 模型 =================
JEV_BASE_URL=https://tokenrhythm.studio
JEV_API_KEY=sk_在这里填平台密钥
CHAT_BASE_URL=https://tokenrhythm.studio
CHAT_API_KEY=sk_在这里填平台密钥
CHAT_MODEL=neohorse-1-9b

# ================= 投稿提取栈（ADR-023）=================
# 层顺序：ocr=专用 OCR 协议（讯飞等）→ vision=视觉模型（Chat Completion 看图）
#         → big=大模型整理（可选层）→ small=小模型（备用层）
SUBMIT_EXTRACT_CHAIN=vision,big,small
# 视觉模型（免费，Chat Completion 协议，图片 base64）
VISION_BASE_URL=https://tokenrhythm.studio
VISION_API_KEY=sk_在这里填平台密钥
VISION_MODEL=
# 大模型（可选层；口语/混乱文本 → 规范通知）
BIG_BASE_URL=https://tokenrhythm.studio
BIG_API_KEY=sk_在这里填平台密钥
BIG_MODEL=
# 小模型（备用层；neohorse-1-9b 禁思考参数，客户端已强制抑制）
SMALL_BASE_URL=https://tokenrhythm.studio
SMALL_API_KEY=sk_在这里填平台密钥
SMALL_MODEL=neohorse-1-9b
# 专用 OCR 协议（provider=none|http|xunfei；星火认知模型本身走 VISION_* 无需此项）
OCR_PROVIDER=none
OCR_BASE_URL=              # provider=http：通用 OCR 端点
OCR_API_KEY=
OCR_API_SECRET=            # provider=xunfei：APISecret
OCR_ENGINE_ID=sf8e6aca1    # provider=xunfei：印刷文字识别引擎 id

# ================= PushPlus 微信强推送（ADR-023）=================
# 全局兜底 token；每用户 token 由用户绑定后存 users 表（/bind_pushplus 或前端接口）
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=            # 可选：群组主题（一对多推送）

# ================= 临期提醒（ADR-023）=================
# 截止前多少小时发提醒（逗号分隔）；抢票前 10 分钟类需求用 0.17 之类小数或另加档位
REMINDER_OFFSETS=24,3
REMINDER_INTERVAL=60       # 调度扫描间隔（秒）

# ================= 劳动教育课程平台（ADR-024）=================
# 会话二选一：CAS 自动登录（一卡通号+密码；需短信/验证码时跳过本轮并告警）
LABOR_USERNAME=
LABOR_PASSWORD=
# 或直接提供 cookie（JSON {"name":"value"} / [{"name","value"}] / "k=v; k=v"）
LABOR_COOKIES=
LABOR_COOKIE_FILE=         # 或 cookie JSON 文件路径

# ================= 人文讲座预约系统（ADR-025，仅监控不预约）=================
# 同一套 CAS（ehall 讲座预约系统）；移植 seu-lecture-cli 监控能力，不用其预约/抢票
SEU_LECTURE_USERNAME=
SEU_LECTURE_PASSWORD=
SEU_LECTURE_COOKIES=

# ================= 管理员 =================
# 告警与复核队列接收人（测试期即你的主号 QQ）
ADMIN_QQ=100000
